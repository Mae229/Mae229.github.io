<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <%- include('partials/head') %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lab6 - Home </title>
</head>
<body>
        <form action="/searchByKeyword" class="mb-3">
            <label class="form-label fw-bold"> Keyword: </label>
            <input id="key" type="text" name="keyword" class="form-control">
            <button id="btn" class="btn btn-primary mt-2"> Search </button>
            <p id="errorMessage"></p>
            <script>
            let errorMessage = document.querySelector("#errorMessage");
            let btn = document.querySelector("#btn").addEventListener("click",function (e) {
            let key = document.querySelector("#key").value;
                if(key.length < 3){
                    e.preventDefault(); 
                    errorMessage.textContent = "Keyword should be atleast 3 characters.";
                    errorMessage.style.color = "red";
                    
                }
            });
        </script>
        </form>
        

        <form action="/searchByAuthor" class="mb-3">
            <label class="form-label fw-bold"> Author: </label>
            <select name="authorId" class="form-select">
                <% for (let a of authors) { %>
                    <option value="<%= a.authorId %>">
                        <%= a.firstName %> <%= a.lastName %>
                    </option>
                <% } %>
            </select>
            <button class="btn btn-primary mt-2"> Search by Author  </button>
        </form>

        <form action="/searchByCategory" class="mb-3">
            <label class="form-label fw-bold"> Category: </label>
            <select name="category" class="form-select">
                <% for (let c of categories) { %>
                    <option value="<%= c.category %>"> <%= c.category %> </option>
                <% } %>
            </select>
            <button class="btn btn-primary mt-2"> Search by Cathegory </button>
        </form>

        <form action="/searchByLikes" class="mb-3">
            <label class="form-label fw-bold"> Likes Range: </label>
            <div class="d-flex gap-2 align-items-center">
                <input type="number" name="minLikes" class="form-control" placeholder="Min">
                <span> to </span>
                <input type="number" name="maxLikes" class="form-control" placeholder="Max">
            </div>
            <button class="btn btn-primary mt-2"> Search by Likes </button>
        </form>

    </div>

    <%- include('partials/footer') %>
</body>
</html>